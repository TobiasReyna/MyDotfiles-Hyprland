{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/mini-ascii.txt",
    "color": {
      "1": "blue",
      "2": "cyan"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "separator": "bright_black"
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "  os",
      "keyColor": "blue",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "  kr",
      "keyColor": "cyan",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "󰅐  up",
      "keyColor": "green",
      "format": "{?days}{days}d {?}{?hours}{hours}h {?}{minutes}m"
    },
    {
      "type": "wm",
      "key": "  wm",
      "keyColor": "magenta",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "󰏖  pk",
      "keyColor": "yellow",
      "format": "{all}"
    },
    {
      "type": "memory",
      "key": "  rm",
      "keyColor": "red",
      "format": "{used} / {total}"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
